# Copy this file to .env and fill in real values. Never commit .env.

# Optional. scripts/autonomous-loop.mjs shells out to the `claude` CLI, which
# manages its own authentication (an existing `claude login` session works
# with no env var at all). Set this only if you want the CLI to authenticate
# via API key instead -- the orchestrator script itself never reads this
# variable directly.
ANTHROPIC_API_KEY=
